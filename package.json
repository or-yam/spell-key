{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "spell-key",
  "title": "Spell Key",
  "description": "Keyboard-first spellcheck with native suggestions.",
  "categories": [
    "Productivity"
  ],
  "icon": "extension-icon.png",
  "author": "or-yam",
  "license": "MIT",
  "commands": [
    {
      "name": "fix-spelling",
      "title": "Fix Spelling",
      "subtitle": "Show list of spelling corrections",
      "description": "Show list of spelling corrections",
      "mode": "view"
    }
  ],
  "keywords": [
    "spellcheck",
    "spelling",
    "spell",
    "spell-check",
    "spell-key"
  ],
  "dependencies": {
    "@raycast/api": "^2.13.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1",
    "publish": "npx @raycast/api@latest publish",
    "test": "node --test tests/spellcheck.test.cjs"
  }
}
